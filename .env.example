# Canonical origin of the deployed site (no trailing slash).
# Used for the sitemap, robots.txt and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://example.com

# Analytics (optional, both are build-time public values).
# Set ONLY ONE provider. If both are set, Plausible takes precedence.

# Plausible: your site's domain as registered in Plausible.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com

# Umami: the website id from your Umami instance, and the script URL
# (e.g. https://umami.example.com/script.js — self-hosted or Umami Cloud).
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# NEXT_PUBLIC_UMAMI_SRC=https://umami.example.com/script.js

# Supabase (Auth + per-user progress). Leave both empty for mock auth in
# local dev / CI. Both are public values; row-level security protects data.
NEXT_PUBLIC_SUPABASE_URL=https://nxxabrigudnurprkxeif.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im54eGFicmlndWRudXJwcmt4ZWlmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk0MzkxNDcsImV4cCI6MjEwNTAxNTE0N30.EVMR94kM7MfQI1PfHBb1dyHAdTaIQOANcIwsCy4W5wM
