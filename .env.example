# Canonical origin of the deployed site (no trailing slash).
# Used for the sitemap, robots.txt and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://example.com

# Analytics (optional, both are build-time — this is a static export).
# Set ONLY ONE provider. If both are set, Plausible takes precedence.

# Plausible: your site's domain as registered in Plausible.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=example.com

# Umami: the website id from your Umami instance, and the script URL
# (e.g. https://umami.example.com/script.js — self-hosted or Umami Cloud).
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# NEXT_PUBLIC_UMAMI_SRC=https://umami.example.com/script.js
